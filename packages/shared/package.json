{
  "name": "@terrasight/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Zod schemas and types shared by web and api: enums, events, units, date formatting",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
