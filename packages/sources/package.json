{
  "name": "@terrasight/sources",
  "version": "0.0.0",
  "private": true,
  "description": "Source adapters (POWER, MODIS, Sentinel-2, CDL, SSURGO, OpenET, …)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
