  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src"
  },
  "dependencies": {
    "geotiff": "3.0.5",
    "proj4": "2.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/proj4": "2.19.0"
  }
}
