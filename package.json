{
  "name": "terrasight",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "library:check": "python3 tools/build_rotations_v2.py --check && pnpm --filter @terrasight/library build && pnpm --filter @terrasight/library validate",
    "i18n:build": "node tools/i18n-build.mjs",
    "i18n:check": "node tools/i18n-build.mjs --check",
    "i18n:unused": "node tools/i18n-unused.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "golden": "node tools/golden/run.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "turbo": "2.11.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
