{
  "name": "@terrasight/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "prisma generate && tsc -p tsconfig.build.json && concurrently -k \"tsc -p tsconfig.build.json -w --preserveWatchOutput\" \"node --watch --enable-source-maps dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint src test",
    "test": "prisma generate && vitest run",
    "test:integration": "prisma generate && vitest run -c vitest.integration.config.ts",
    "db:migrate": "prisma migrate deploy",
    "db:diff": "prisma migrate diff --from-empty --to-schema ../../prisma/schema.prisma --script"
  },
  "dependencies": {
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@terrasight/library": "workspace:*",
    "@terrasight/shared": "workspace:*",
    "amqplib": "2.3.1",
    "cookie-parser": "1.4.7",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.5.0",
    "@swc/core": "1.16.22",
    "@testcontainers/postgresql": "12.2.1",
    "@types/amqplib": "0.10.8",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.7",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "testcontainers": "12.2.1",
    "unplugin-swc": "2.0.0"
  }
}
