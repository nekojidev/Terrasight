{
  "name": "@terrasight/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "prisma generate && tsc -p tsconfig.build.json && concurrently -k \"tsc -p tsconfig.build.json -w --preserveWatchOutput\" \"node --env-file-if-exists=../../.env --watch --enable-source-maps dist/main.js\"",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint src test",
    "test": "prisma generate && vitest run",
    "test:integration": "prisma generate && vitest run -c vitest.integration.config.ts",
    "db:migrate": "prisma migrate deploy",
    "db:diff": "prisma migrate diff --from-empty --to-schema ../../prisma/schema.prisma --script",
    "test:contract": "node ../../tools/postman/build-collection.mjs && postman collection run postman/terrasight-p0.postman_collection.json --env-var baseUrl=${API_BASE_URL:-http://localhost:4000}",
    "boundaries:load": "node --env-file-if-exists=../../.env scripts/load-boundaries.mjs",
    "boundaries:check": "node --env-file-if-exists=../../.env scripts/check-region-points.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.999.0",
    "@aws-sdk/s3-request-presigner": "3.999.0",
    "@google/genai": "2.9.0",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/node": "11.12.0",
    "@terrasight/assistant-core": "workspace:*",
    "@terrasight/climate": "workspace:*",
    "@terrasight/evaluators": "workspace:*",
    "@terrasight/library": "workspace:*",
    "@terrasight/scenario-engine": "workspace:*",
    "@terrasight/shared": "workspace:*",
    "@terrasight/simulator": "workspace:*",
    "@terrasight/sources": "workspace:*",
    "amqplib": "2.3.1",
    "argon2": "0.45.2",
    "cookie-parser": "1.4.7",
    "ioredis": "6.0.0",
    "jose": "6.2.17",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.5.0",
    "@swc/core": "1.16.22",
    "@testcontainers/postgresql": "12.2.1",
    "@types/amqplib": "0.10.8",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.7",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "testcontainers": "12.2.1",
    "unplugin-swc": "2.0.0"
  }
}
