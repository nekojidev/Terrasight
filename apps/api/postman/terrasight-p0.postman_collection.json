      "name": "Auth (S-01.01)",
      "item": [
        {
          "name": "Sign up the owner",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"access + refresh cookies are httpOnly\", () => {",
                  "  const set = pm.response.headers.filter((h) => h.key.toLowerCase() === \"set-cookie\").map((h) => h.value).join(\"\\n\");",
                  "  pm.expect(set).to.match(/ts_at=[^;]+;.*HttpOnly/i);",
                  "  pm.expect(set).to.match(/ts_rt=[^;]+;.*Path=\\/api\\/auth.*HttpOnly/i);",
                  "  pm.expect(set).to.match(/SameSite=Lax/i);",
                  "});",
                  "pm.test(\"returns the user without workspaces\", () => {",
                  "  const b = pm.response.json(); pm.expect(b.email).to.eql(pm.collectionVariables.get(\"ownerEmail\"));",
                  "  pm.expect(b.workspaces).to.eql([]); pm.expect(b).to.not.have.property(\"passwordHash\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Requested-With",
                "value": "XMLHttpRequest"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/signup",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"correct horse battery\",\n  \"name\": \"Olena Koval\",\n  \"uiLanguage\": \"uk\"\n}"
            }
          }
        },
        {
          "name": "Mutating request without X-Requested-With is refused (CSRF)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 403\", () => pm.response.to.have.status(403));",
                  "pm.test(\"problem+json\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));",
                  "pm.test(\"type csrf\", () => pm.expect(pm.response.json().type).to.include(\"csrf\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/workspaces",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"x\",\n  \"timeZone\": \"UTC\",\n  \"units\": \"metric\",\n  \"reportLanguage\": \"en\"\n}"
            }
          }
        },
