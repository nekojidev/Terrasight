# Terrasight environment (Tech Design §17). Copy to .env for local runs outside docker compose.
NODE_ENV=development
ROLE=all
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://terrasight:terrasight@localhost:5432/terrasight
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# Optional: without it the app runs on in-process fallbacks (RFC §5.2).
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:3000
# HS256 key for access tokens, at least 32 characters. Use a long random value outside local development.
JWT_SECRET=local-development-only-change-me-0123456789

# Email (password reset). Required in production: smtp[s]://user:pass@host:port
# (an Amazon SES SMTP endpoint works). Unset in development: emails are written to uploads/outbox/ (gitignored).
# SMTP_URL=
# EMAIL_FROM=Terrasight <no-reply@example.com>
# Contract / E2E runs only (refused in production): GET /api/test/outbox?to=<email> returns the latest link.
# AUTH_TEST_HOOKS=1
# Cost limits and photo caps (defaults shown).
# MAX_FIELDS_PER_WORKSPACE=200
# PHOTO_MAX_BYTES=10485760
# PHOTO_MAX_PER_POINT=6
# PHOTO_MAX_PER_TASK=30
# Added by later epics:
# GEMINI_API_KEY=
# GEMINI_MODEL=
# AI_ROTATIONS=1
# AI_RECOMMENDATIONS=1
# Optional: without it the free Open-Meteo endpoint is used.
# OPEN_METEO_API_KEY=
# OPENET_API_KEY=
# NASS_API_KEY=
# NASA Earthdata Login bearer token (urs.earthdata.nasa.gov): used for the GPM IMERG rainfall check (S-10.11). Optional; without it the check says "unavailable". The profile must accept the "NASA GESDISC DATA ARCHIVE" application.
# EARTHDATA_TOKEN=
# CDSE_CLIENT_ID=
# CDSE_CLIENT_SECRET=
# S3_BUCKET=
# Optional error reporting (API: @sentry/node; web: build-time NEXT_PUBLIC_SENTRY_DSN). Unset = off.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=
# SENTRY_RELEASE=
# NEXT_PUBLIC_SENTRY_DSN=
# Optional satellite basemap override for the web build (default: EOX Sentinel-2 cloudless 2016, CC BY 4.0).
# NEXT_PUBLIC_BASEMAP_TILES=
# NEXT_PUBLIC_BASEMAP_ATTRIBUTION=
